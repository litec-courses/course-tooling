{
  "name": "slidev-theme-litec",
  "version": "0.8.0",
  "private": true,
  "description": "Shared Slidev theme for LiTec courses",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "files": [
    "scripts/",
    "global-bottom.vue",
    "global-top.vue",
    "layouts/",
    "assets/",
    "setup/",
    "styles/"
  ],
  "bin": {
    "litec-course-publish": "./scripts/publish.mjs"
  },
  "engines": {
    "node": ">=22.12.0",
    "slidev": ">=53.0.0"
  },
  "scripts": {
    "dev": "slidev examples/default.md",
    "build": "slidev build examples/default.md --out ../dist/default && slidev build examples/widescreen.md --out ../dist/widescreen",
    "export": "slidev export examples/default.md --output dist/example.pdf && slidev export examples/widescreen.md --output dist/example-widescreen.pdf",
    "pages:build": "node scripts/publish.mjs",
    "test:publish": "PUBLISH_CONFIG=examples/publish.yml PUBLISH_OUTPUT=dist/publisher-test node scripts/publish.mjs",
    "test:publish:skip-pdf": "PUBLISH_CONFIG=examples/publish.yml PUBLISH_OUTPUT=dist/publisher-test node scripts/publish.mjs --skip-pdf"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "3/2",
      "canvasWidth": 980,
      "colorSchema": "light",
      "transition": "fade",
      "favicon": "data:image/png;base64,",
      "fonts": {
        "provider": "none",
        "sans": "Inter",
        "mono": "JetBrains Mono"
      },
      "themeConfig": {
        "primary": "#01315c",
        "courseLabel": "Course"
      },
      "drawings": {
        "persist": false
      }
    }
  },
  "dependencies": {
    "@slidev/theme-default": "0.25.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@slidev/cli": "53.0.0",
    "playwright-chromium": "1.64.1"
  }
}
